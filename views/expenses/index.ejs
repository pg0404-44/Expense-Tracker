<% layout("/layouts/boilerplate") %>

<div class="container my-5">

  <!-- Top Bar -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">All Expenses</h2>
    <a href="/listexpenses/new" class="btn btn-success">+ Add Expense</a>
  </div>

  <!-- Search & Filter Card -->
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
      <form method="GET" action="/expenses/filter">

        <div class="row g-3">

          <!-- Keyword Search -->
          <div class="col-md-4">
            <label class="form-label fw-semibold">Search</label>
            <input
              type="text"
              name="keyword"
              class="form-control"
              placeholder="Search title, category, note..."
              value="<%= typeof keyword !== 'undefined' ? keyword : '' %>"
            >
          </div>

          <!-- Category -->
          <div class="col-md-2">
            <label class="form-label fw-semibold">Category</label>
            <input
              type="text"
              name="category"
              class="form-control"
              placeholder="e.g. Food"
              value="<%= typeof category !== 'undefined' ? category : '' %>"
            >
          </div>

          <!-- Min Amount -->
          <div class="col-md-1">
            <label class="form-label fw-semibold">Min ₹</label>
            <input
              type="number"
              name="min"
              class="form-control"
              placeholder="0"
              value="<%= typeof min !== 'undefined' ? min : '' %>"
            >
          </div>

          <!-- Max Amount -->
          <div class="col-md-1">
            <label class="form-label fw-semibold">Max ₹</label>
            <input
              type="number"
              name="max"
              class="form-control"
              placeholder="9999"
              value="<%= typeof max !== 'undefined' ? max : '' %>"
            >
          </div>

          <!-- Start Date -->
          <div class="col-md-2">
            <label class="form-label fw-semibold">From</label>
            <input
              type="date"
              name="startDate"
              class="form-control"
              value="<%= typeof startDate !== 'undefined' ? startDate : '' %>"
            >
          </div>

          <!-- End Date -->
          <div class="col-md-2">
            <label class="form-label fw-semibold">To</label>
            <input
              type="date"
              name="endDate"
              class="form-control"
              value="<%= typeof endDate !== 'undefined' ? endDate : '' %>"
            >
          </div>

        </div>

        <!-- Buttons -->
        <div class="mt-3 d-flex gap-2">
          <button type="submit" class="btn btn-success">
            <i class="fa-solid fa-filter"></i> Apply Filter
          </button>
          <a href="/listexpenses" class="btn btn-outline-secondary">
            <i class="fa-solid fa-rotate-left"></i> Reset
          </a>
        </div>

      </form>
    </div>
  </div>

  <!-- Results Count -->
  <p class="text-muted mb-2">
    Showing <strong><%= allExpenses.length %></strong> expense(s)
  </p>

  <!-- Expense Table -->
  <div class="card shadow-sm border-0">
    <div class="card-body">
      <% if(allExpenses.length === 0){ %>
        <div class="text-center py-5 text-muted">
          <i class="fa-solid fa-inbox fa-3x mb-3"></i>
          <p class="fs-5">No expenses found.</p>
          <a href="/listexpenses" class="btn btn-outline-success">Clear Filters</a>
        </div>
      <% } else { %>
        <table class="table table-hover align-middle">
          <thead class="table-dark">
            <tr>
              <th>#</th>
              <th>Title</th>
              <th>Category</th>
              <th>Amount</th>
              <th>Date</th>
              <th>Note</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% allExpenses.forEach((expense, index) => { %>
              <tr onclick="window.location='/listexpenses/<%= expense._id %>'"
                  style="cursor:pointer;">
                <td><%= index + 1 %></td>
                <td class="fw-semibold"><%= expense.title %></td>
                <td>
                  <span class="badge bg-primary px-3 py-2">
                    <%= expense.category %>
                  </span>
                </td>
                <td class="text-danger fw-bold">
                  ₹ <%= expense.amount.toLocaleString("en-IN") %>
                </td>
                <td><%= expense.Date.toISOString().split('T')[0] %></td>
                <td><%= expense.note %></td>
                <td onclick="event.stopPropagation();">
                  <a href="/listexpenses/<%= expense._id %>/edit"
                     class="btn btn-warning btn-sm">Edit</a>
                  <form action="/listexpenses/<%= expense._id %>?_method=DELETE"
                        method="POST" class="d-inline">
                    <button class="btn btn-danger btn-sm">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

</div>