<% layout("/layouts/boilerplate") %>

<div class="hero-section text-center py-5">
  <div class="container">

    <!-- Icon -->
    <div class="mb-4">
      <i class="fa-solid fa-wallet" style="font-size:4rem; color:#137f39;"></i>
    </div>

    <!-- Heading -->
    <h1 class="display-4 fw-bold mb-3">
      Smart Expense Tracker
    </h1>
    <p class="lead text-muted mb-4">
      Track your spending, analyze your habits, and take control of your finances — all in one place.
    </p>

    <!-- CTA Buttons -->
    <% if(!currUser){ %>
      <a href="/signup" class="btn btn-success btn-lg me-3">
        Get Started — It's Free
      </a>
      <a href="/login" class="btn btn-outline-secondary btn-lg">
        Login
      </a>
    <% } else { %>
      <a href="/listexpenses" class="btn btn-success btn-lg me-3">
        View My Expenses
      </a>
      <a href="/listexpenses/new" class="btn btn-outline-success btn-lg">
        + Add Expense
      </a>
    <% } %>

  </div>
</div>

<!-- Features Section -->
<div class="container my-5">
  <div class="row text-center g-4">

    <div class="col-md-4">
      <div class="card border-0 shadow-sm p-4 h-100">
        <i class="fa-solid fa-list-check fa-2x mb-3" style="color:#137f39;"></i>
        <h5 class="fw-bold">Track Expenses</h5>
        <p class="text-muted">
          Log every expense with title, category, date, and notes. Stay on top of where your money goes.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-0 shadow-sm p-4 h-100">
        <i class="fa-solid fa-chart-pie fa-2x mb-3" style="color:#137f39;"></i>
        <h5 class="fw-bold">Analyze Spending</h5>
        <p class="text-muted">
          Visual charts show your spending by category and month so you can spot patterns instantly.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-0 shadow-sm p-4 h-100">
        <i class="fa-solid fa-piggy-bank fa-2x mb-3" style="color:#137f39;"></i>
        <h5 class="fw-bold">Save More</h5>
        <p class="text-muted">
          Understand your habits and make smarter financial decisions every day.
        </p>
      </div>
    </div>

  </div>
</div>